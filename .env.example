# Copy this file to .env.local for local development with `vercel dev`.
# NEVER commit a file containing real values — only commit .env.example.

# Required — Gemini API key, used only inside /api serverless functions.
GEMINI_API_KEY=your_key_here

# Optional — override the Gemini model (defaults to gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash

# Required — long random string used to sign session JWTs.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string

# Optional but recommended for production — connect the "Vercel KV"
# integration from your Vercel project dashboard and it will inject these
# automatically. Without them, registered accounts only persist for the
# lifetime of a single serverless instance (fine for local dev/demo, not
# for a real deployment).
KV_REST_API_URL=
KV_REST_API_TOKEN=
